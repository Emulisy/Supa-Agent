# DeepSeek API key. Supported model IDs and endpoints are in configs/llm.yaml.
DEEPSEEK_API_KEY=

# MySQL connection to an existing database. Replace the example credentials.
MYSQL_DSN=app:password@tcp(127.0.0.1:3306)/supa_agent?parseTime=true&charset=utf8mb4&timeout=5s

# Redis connection to an existing server. Username and password are optional.
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# HTTP API and authentication. Generate a secret with at least 32 random bytes.
HTTP_ADDR=127.0.0.1:8080
JWT_SECRET=
JWT_ACCESS_TTL=15m

# Local conversations and background runs (one API process per directory).
SESSION_DIR=data/sessions
LLM_CONFIG=configs/llm.yaml
RUN_TIMEOUT=5m
RUN_MAX_CONCURRENT=8
SHUTDOWN_TIMEOUT=10s
